# Copy to .env.local. This file contains no credentials.
# Model calls also require a verified route with no additional charges.
# The UI director automatically selects an allowed route from the live registry.
# Optional pin; unavailable pins fail instead of falling back:
# ORCHESTRATOR_DIRECTOR_ROUTE=opencode:opencode/big-pickle
# ORCHESTRATOR_OPENCODE_COMMAND=/absolute/path/to/opencode
# Current Codex metadata does not establish an included-only billing boundary.
# Set a native codex executable path if it is not on PATH:
# ORCHESTRATOR_PLANNER_COMMAND=/path/to/codex

# Real execution uses the same saved CLI login. It has a separate model setting.
ORCHESTRATOR_EXECUTOR_MODEL=gpt-6.1-sol
ORCHESTRATOR_EXECUTOR_REASONING=high
# ORCHESTRATOR_EXECUTOR_COMMAND=/path/to/codex
